# Supabase Configuration
# Replace these with your actual Supabase Project URL and Public Anon Key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Cloudinary Configuration (Server-side Secrets for Vercel / Supabase Edge Functions)
# NEVER put CLOUDINARY_API_SECRET in frontend Vite variables
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: Cloudinary Client Variables (Public cloud name and optional unsigned upload preset)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

